{
  "name": "claude-web-shortcuts",
  "version": "0.1.0",
  "private": true,
  "description": "Custom keyboard shortcuts for claude.ai (Chrome MV3 extension)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@eslint/js": "^9.39.5",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.4",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "preact": "^11.0.1"
  }
}
